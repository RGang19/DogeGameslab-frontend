# Copy this file to .env and fill in values.
# Vite only exposes variables prefixed with VITE_ to the browser.

# --- App ---
VITE_APP_NAME="DogeGameLab"

# --- PostHog analytics ---
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- API ---
# Local dev: keep /api (vite.config.ts proxies to http://127.0.0.1:3001)
# Production: set full URL, e.g. https://your-api.example.com/api
VITE_API_URL=/api

# --- Thumbnails CDN ---
VITE_THUMBNAILS_BASE=https://creator-studio.sfo3.digitaloceanspaces.com/thumbnails

# --- DogeOS SDK (sign-in + wallet) ---
# Public client ID from https://sdk.dogeos.com/register. Register every origin
# that serves this app, including local dev (http://localhost:5174).
VITE_DOGEOS_CLIENT_ID=
# DogeOS network — Chikyū testnet today; switch to mainnet values at launch.
VITE_DOGEOS_CHAIN_ID=6281971
VITE_DOGEOS_CHAIN_NAME="DogeOS Chikyū Testnet"
VITE_DOGEOS_RPC_URL=https://rpc.testnet.dogeos.com/
VITE_DOGEOS_EXPLORER_URL=https://dogeos-testnet.l2scan.co
VITE_DOGEOS_TESTNET=true
# Optional overrides for the wallet panel links.
# VITE_DOGEOS_FAUCET_URL=

# --- 0G payments ---
# Paid generations and Creator subscriptions settle in 0G on 0G mainnet; the
# DogeOS wallet switches to 0G to pay.
VITE_ZERO_G_MAINNET_CHAIN_ID=16661
VITE_ZERO_G_MAINNET_RPC_URL=https://evmrpc.0g.ai
VITE_ZERO_G_TREASURY_WALLET=
# Optional page opened by "Add 0G" (where users can buy or bridge 0G).
# VITE_ZERO_G_FUNDING_URL=

# Creator subscription prices and the live contract address are deliberately
# read from the backend/chain, so no subscription price is trusted from Vite.

# --- Local dev notes ---
# 1. Start backend on port 3001 (Creator Studio API)
# 2. npm run dev
# 3. Open http://localhost:5174/create/
